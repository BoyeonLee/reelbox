# .env.example — 이 파일을 .env 로 복사해서 값을 채운다. .env 는 커밋하지 않는다.

# Claude API 키 (Phase 3)
ANTHROPIC_API_KEY=

# 휴대폰·단축어 접속용 긴 비밀 토큰 (Phase 5). 예: openssl rand -hex 32
REELBOX_TOKEN=

# 데이터 폴더 (기본: 프로젝트 루트의 data/)
# REELBOX_DATA_DIR=data

# 유튜브 로그인 쿠키: 브라우저 이름 또는 cookies.txt 경로 중 하나
REELBOX_YOUTUBE_COOKIES_FROM_BROWSER=
REELBOX_YOUTUBE_COOKIES_FILE=secrets/youtube_cookies.txt

# 인스타그램 로그인 쿠키: 브라우저 이름 또는 cookies.txt 경로 중 하나
REELBOX_INSTAGRAM_COOKIES_FROM_BROWSER=
REELBOX_INSTAGRAM_COOKIES_FILE=

# 유튜브 "저장된 Shorts 동영상" 재생목록 주소 (youtube.com/playlist?list=...)
REELBOX_YOUTUBE_SAVED_SHORTS_URL=

# 보강(enrich) — 비워 두면 기본값. 인스타 요청 간격은 5초 미만으로 내릴 수 없다.
# REELBOX_INSTAGRAM_DAILY_LIMIT=200
# REELBOX_INSTAGRAM_DELAY_MIN_SEC=5
# REELBOX_INSTAGRAM_DELAY_MAX_SEC=10
# 이보다 긴 영상은 받아쓰기를 건너뛴다 (초)
# REELBOX_MAX_TRANSCRIBE_SEC=180
# 음성 받아쓰기 모델: tiny / base / small / medium / large-v3 (클수록 정확하지만 느림)
# REELBOX_WHISPER_MODEL=small
# REELBOX_WHISPER_DEVICE=cpu
# REELBOX_WHISPER_COMPUTE_TYPE=int8

# AI 분석(analyze) — 비워 두면 기본값. 모델을 바꾸면 가격(100만 토큰당 달러)도 바꾼다.
# REELBOX_ANALYZE_MODEL=claude-haiku-5-5
# REELBOX_ANALYZE_EFFORT=low
# REELBOX_ANALYZE_PRICE_INPUT_PER_MTOK=0.10
# REELBOX_ANALYZE_PRICE_OUTPUT_PER_MTOK=0.50
# REELBOX_TRANSCRIPT_MAX_CHARS=6000
