# .env.example — 이 파일을 .env 로 복사해서 값을 채운다. .env 는 커밋하지 않는다.

# Claude API 키 (Phase 3)
ANTHROPIC_API_KEY=

# 휴대폰·단축어 접속용 긴 비밀 토큰 (Phase 5). 예: openssl rand -hex 32
REELBOX_TOKEN=

# 데이터 폴더 (기본: 프로젝트 루트의 data/)
# REELBOX_DATA_DIR=data

# 유튜브 로그인 쿠키: 브라우저 이름 또는 cookies.txt 경로 중 하나
REELBOX_YOUTUBE_COOKIES_FROM_BROWSER=
REELBOX_YOUTUBE_COOKIES_FILE=secrets/youtube_cookies.txt

# 인스타그램 로그인 쿠키: 브라우저 이름 또는 cookies.txt 경로 중 하나
REELBOX_INSTAGRAM_COOKIES_FROM_BROWSER=
REELBOX_INSTAGRAM_COOKIES_FILE=

# 유튜브 "저장된 Shorts 동영상" 재생목록 주소 (youtube.com/playlist?list=...)
REELBOX_YOUTUBE_SAVED_SHORTS_URL=
